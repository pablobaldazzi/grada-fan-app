# Local development example values.
# Do not use localhost or mock data for EAS/App Store release builds.

# Build variant (rangers, deportes-concepcion, palestino, puerto-montt). Used by app.config for app identity.
APP_VARIANT=rangers

# Local backend API base URL. Localhost is accepted only for dev/start flows.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3002

# Club slug override (optional). Overrides APP_VARIANT-derived slug at runtime when set.
EXPO_PUBLIC_CLUB_SLUG=rangers

# Enable demo mode with mock data (local development only).
EXPO_PUBLIC_USE_MOCK_DATA=false

# Production release example. Set these through EAS env/secrets or your release shell,
# not by committing real production values to this file.
# APP_VARIANT=puerto-montt
# EXPO_PUBLIC_CLUB_SLUG=puerto-montt
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
# EXPO_PUBLIC_USE_MOCK_DATA=false

# Push notifications require the EAS project id in production builds.
# Use EXPO_PUBLIC_EAS_PROJECT_ID for client-visible config, or EAS_PROJECT_ID
# as a non-public build env fallback consumed by app.config.ts.
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Clerk Authentication (required for real auth)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: used by server and build for domain (e.g. Replit). Leave unset for local Expo.
# EXPO_PUBLIC_DOMAIN=
# DATABASE_URL=postgresql://...   # only if using drizzle scripts (e.g. db:push)
